# Copy to .env and fill in. Generate each secret once and keep it:
#   openssl rand -hex 32   (SESSION_SECRET, ENCRYPTION_KEY)
#   openssl rand -hex 16   (DB_PASSWORD)

# Signs session cookies. At least 32 characters.
SESSION_SECRET=

# Password of the bundled PostgreSQL (database and user are both "mailflow").
DB_PASSWORD=

# Encrypts stored mail account passwords and OAuth tokens. Exactly 64 hex characters.
# If it is lost or changed, every mail account has to be signed in again.
ENCRYPTION_KEY=

# The URL people open Plimail at, without a trailing slash, e.g. https://mail.example.com
# or http://192.168.1.10:3000. The WebSocket and sign-in redirects only accept this origin.
APP_URL=

# Reverse proxies in front of Plimail: 1 (default) behind your HTTPS proxy, 0 when browsers
# connect directly (to either port). With 1, only your proxy may reach the ports, or a client can
# fake its address.
# TRUST_PROXY_HOPS=1

# Host ports: HTTP, default 3000, and HTTPS with a self-signed certificate, default 3443. Use
# 127.0.0.1:3000 when the proxy runs on the same host.
# HTTP_PORT=3000
# HTTPS_PORT=3443
